          }
        },
        "nextOffset": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "v1ChangePasswordResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      }
    },
    "v1DailyStatus": {
      "type": "object",
      "properties": {
        "hasPlayedToday": {
          "type": "boolean"
        },
        "sessionId": {
          "type": "string",
          "title": "If played, the session ID"
        },
        "status": {
          "$ref": "#/definitions/v1GameStatus",
          "title": "If played, the game status"
        }
      },
      "title": "DailyStatus is the response for daily game status check"
    },
    "v1DeleteUserResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "v1GameHistoryItem": {
      "type": "object",
      "properties": {
        "historyId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "gameMode": {
          "type": "string"
        },
        "gameDate": {
          "type": "string"
        },
        "targetWord": {
          "type": "string"
        },
        "guesses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "result": {
          "type": "string"
        },
        "attemptsUsed": {
          "type": "integer",
          "format": "int32"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "title": "GameHistoryItem represents a single game in history"
    },
    "v1GameMode": {
      "type": "string",
      "enum": [
        "GAME_MODE_UNSPECIFIED",
        "GAME_MODE_DAILY",
        "GAME_MODE_RANDOM"
      ],
      "default": "GAME_MODE_UNSPECIFIED",
      "title": "GameMode represents the type of game"
    },
    "v1GameSession": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "gameMode": {
          "$ref": "#/definitions/v1GameMode"
        },
        "gameDate": {
          "type": "string",
          "title": "YYYY-MM-DD for daily games"
        },
        "status": {
          "$ref": "#/definitions/v1GameStatus"
        },
        "attemptsUsed": {
          "type": "integer",
          "format": "int32"
        },
        "maxAttempts": {
          "type": "integer",
          "format": "int32"
        },
        "guesses": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Guess"
          }
        },
        "targetWord": {
          "type": "string",
          "title": "Only revealed when game is over"
        },
        "startedAt": {
          "type": "string"
        },
        "completedAt": {
          "type": "string"
        }
      },
      "title": "GameSession represents an active or completed game"
    },
    "v1GameStatus": {
      "type": "string",
      "enum": [
        "GAME_STATUS_UNSPECIFIED",
        "GAME_STATUS_IN_PROGRESS",
        "GAME_STATUS_WON",
        "GAME_STATUS_LOST"
      ],
      "default": "GAME_STATUS_UNSPECIFIED",
      "title": "GameStatus represents the current status of a game"
    },
    "v1GetDailyLeaderboardResponse": {
      "type": "object",
      "properties": {
        "gameDate": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1LeaderboardEntry"
          }
        }
      }
    },
    "v1GetMyHistoryResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1GameHistoryItem"
          }
        },
        "nextPageToken": {
          "type": "string"
        }
      }
    },
    "v1Guess": {
      "type": "object",
      "properties": {
        "word": {
          "type": "string"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/v1LetterResult"
          }
        },
        "attemptNumber": {
          "type": "integer",
          "format": "int32"
        }
      },
      "title": "Guess represents a single guess in a game"
    },
    "v1GuessDistribution": {
      "type": "object",
      "properties": {
        "one": {
          "type": "integer",
          "format": "int32"
        },
        "two": {
          "type": "integer",
          "format": "int32"
        },
        "three": {
          "type": "integer",
          "format": "int32"
        },
        "four": {
          "type": "integer",
          "format": "int32"
        },
        "five": {
          "type": "integer",
          "format": "int32"
        },
        "six": {
          "type": "integer",
          "format": "int32"
        }
      },
      "title": "GuessDistribution shows how many games were won in N guesses"
    },
    "v1GuessResult": {
      "type": "object",
      "properties": {
        "guess": {
          "$ref": "#/definitions/v1Guess"
        },
        "gameStatus": {
          "$ref": "#/definitions/v1GameStatus"
        },
        "targetWord": {
          "type": "string",
          "title": "Only set if game is over"
        }
      },
      "title": "GuessResult is the result of a guess submission"
    },
    "v1LeaderboardEntry": {
      "type": "object",
      "properties": {
        "rank": {
          "type": "integer",
          "format": "int32"
        },
        "userId": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "attemptsUsed": {
          "type": "integer",
          "format": "int32"
