{
  "dashboard": {
    "title": "Quiz Platform - Gateway Metrics",
    "description": "Gateway performance and API metrics",
    "tags": ["gateway", "api", "microservices"],
    "style": "dark",
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      // ====================
      // ROW 1: Общая статистика
      // ====================
      {
        "title": "Total Requests",
        "type": "stat",
        "gridPos": {"h": 3, "w": 3, "x": 0, "y": 0},
        "targets": [{
          "expr": "sum(gateway_http_requests_total)",
          "instant": true,
          "legendFormat": "Total"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "title": "RPS (Requests Per Second)",
        "type": "stat",
        "gridPos": {"h": 3, "w": 3, "x": 3, "y": 0},
        "targets": [{
          "expr": "sum(rate(gateway_http_requests_total[1m]))",
          "instant": true,
          "legendFormat": "RPS"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "title": "Error Rate %",
        "type": "stat",
        "gridPos": {"h": 3, "w": 3, "x": 6, "y": 0},
        "targets": [{
          "expr": "(sum(rate(gateway_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(gateway_http_requests_total[5m]))) * 100",
          "instant": true,
          "legendFormat": "5xx Errors"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "color": {"mode": "thresholds"}
          }
        }
      },
      {
        "title": "Inflight Requests",
        "type": "stat",
        "gridPos": {"h": 3, "w": 3, "x": 9, "y": 0},
        "targets": [{
          "expr": "gateway_http_inflight_requests",
          "instant": true,
          "legendFormat": "Inflight"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "palette-classic"}
          }
        }
      },

      // ====================
      // ROW 2: Распределение запросов по ручкам (БЕЗ кода ответа)
      // ====================
      {
        "title": "Request Rate by Endpoint (req/s)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 3},
        "targets": [{
          "expr": "sum(rate(gateway_http_requests_total[1m])) by (endpoint)",
          "legendFormat": "{{endpoint}}"
        }],
        "options": {
          "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["last"]}
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {"drawStyle": "line", "lineInterpolation": "smooth"}
          }
        }
      },

      {
        "title": "Top 10 Endpoints by Request Count",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 3},
        "targets": [{
          "expr": "topk(10, sum(rate(gateway_http_requests_total[5m])) by (endpoint))",
          "instant": true,
          "format": "table"
        }],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0,
            "custom": {"axisPlacement": "auto"}
          }
        }
      },

      // ====================
      // ROW 3: Распределение кодов ответов по ручкам
      // ====================
      {
        "title": "HTTP Status Codes by Endpoint (2xx/4xx/5xx)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 11},
        "targets": [
          {
            "expr": "sum(rate(gateway_http_requests_total{status=~\"2..\"}[1m])) by (endpoint)",
            "legendFormat": "{{endpoint}} - 2xx"
          },
          {
            "expr": "sum(rate(gateway_http_requests_total{status=~\"4..\"}[1m])) by (endpoint)",
            "legendFormat": "{{endpoint}} - 4xx"
          },
          {
            "expr": "sum(rate(gateway_http_requests_total{status=~\"5..\"}[1m])) by (endpoint)",
            "legendFormat": "{{endpoint}} - 5xx"
          }
        ],
        "options": {
          "legend": {"displayMode": "table", "placement": "bottom"}
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {"drawStyle": "line", "lineInterpolation": "smooth"}
          }
        }
      },

      {
        "title": "Error Rate by Endpoint (%)",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 11},
        "targets": [{
          "expr": "(sum(rate(gateway_http_requests_total{status=~\"5..\"}[5m])) by (endpoint) / sum(rate(gateway_http_requests_total[5m])) by (endpoint)) * 100",
          "legendFormat": "{{endpoint}}"
        }],
        "options": {
          "calculation": {"yBuckets": {"mode": "count", "value": "10"}}
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "color": {"mode": "scheme", "schemeName": "Spectral"}
          }
        }
      },

      // ====================
      // ROW 4: Performance метрики (из дефолтных Go метрик)
      // ====================
      {
        "title": "Go Goroutines",
        "type": "graph",
        "gridPos": {"h": 6, "w": 6, "x": 0, "y": 19},
        "targets": [{
          "expr": "go_goroutines",
          "legendFormat": "Goroutines"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {"drawStyle": "line"}
          }
        }
      },

      {
        "title": "Go Memory Usage",
        "type": "graph",
        "gridPos": {"h": 6, "w": 6, "x": 6, "y": 19},
        "targets": [
          {
            "expr": "go_memstats_heap_alloc_bytes",
            "legendFormat": "Heap Alloc"
          },
          {
            "expr": "go_memstats_heap_sys_bytes",
            "legendFormat": "Heap Sys"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "custom": {"drawStyle": "line"}
          }
        }
      },

      {
        "title": "Go GC Pause Duration",
        "type": "graph",
        "gridPos": {"h": 6, "w": 6, "x": 12, "y": 19},
        "targets": [{
          "expr": "rate(go_gc_pauses_seconds_total[1m])",
          "legendFormat": "GC Pauses"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {"drawStyle": "line"}
          }
        }
      },

      {
        "title": "CPU Usage",
        "type": "graph",
        "gridPos": {"h": 6, "w": 6, "x": 18, "y": 19},
        "targets": [{
          "expr": "rate(process_cpu_seconds_total[1m]) * 100",
          "legendFormat": "CPU %"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": {"drawStyle": "line"}
          }
        }
      },

      // ====================
      // ROW 5: Табличные представления
      // ====================
      {
        "title": "Requests by Method and Endpoint (table)",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 25},
        "targets": [{
          "expr": "sum(rate(gateway_http_requests_total[5m])) by (method, endpoint)",
          "instant": true,
          "format": "table"
        }],
        "options": {
          "showHeader": true,
          "sortBy": ["Requests"]
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "displayName": "RPS"
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "method"},
              "properties": [{"id": "displayName", "value": "Method"}]
            },
            {
              "matcher": {"id": "byName", "options": "endpoint"},
              "properties": [{"id": "displayName", "value": "Endpoint"}]
            }
          ]
        }
      },

      {
        "title": "Response Time by Endpoint (p95)",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 25},
        "targets": [{
          "expr": "histogram_quantile(0.95, rate(gateway_http_request_duration_seconds_bucket[5m])) by (endpoint, method)",
          "instant": true,
          "format": "table"
        }],
        "options": {
          "showHeader": true,
          "sortBy": ["Duration"]
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 3,
            "displayName": "p95 Latency"
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "endpoint"},
              "properties": [{"id": "displayName", "value": "Endpoint"}]
            },
            {
              "matcher": {"id": "byName", "options": "method"},
              "properties": [{"id": "displayName", "value": "Method"}]
            }
          ]
        }
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d"]
    }
  },
  "overwrite": true,
  "folderUid": "",
  "message": "Updated gateway metrics dashboard"
}